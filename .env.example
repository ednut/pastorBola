# Settings for the website forms. Add these in Vercel: Project, Settings, Environment Variables.
# Never commit real values. See README.md, section "Forms".

# --- Sending email (ZeptoMail) ---
# From the ZeptoMail agent's "Send Mail API" tab. Copy the API URL exactly as shown there.
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_KEY=

# The address emails are sent from. Its domain must be verified in ZeptoMail.
FORMS_FROM_EMAIL=info@bolaakinlabi.org
FORMS_FROM_NAME=Pastor Bola Akinlabi

# Who receives form submissions. Separate several addresses with commas.
FORMS_NOTIFY_EMAIL=

# Optional: where replies to confirmation emails should go (defaults to the sender).
FORMS_REPLY_TO=

# --- Saved contact lists (Brevo, free plan is enough) ---
# Used only to keep the book waiting list and newsletter contacts.
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
BREVO_NEWSLETTER_LIST_ID=
