# Settings for the website forms. Add these in Vercel: Project, Settings, Environment Variables.
# Never commit real values. See README.md, section "Forms".

# Brevo API key (Brevo account, SMTP & API, API keys)
BREVO_API_KEY=

# The address confirmation emails are sent from. It must be a verified sender in Brevo.
FORMS_FROM_EMAIL=office@example.org
FORMS_FROM_NAME=Pastor Bola Akinlabi

# Who receives form submissions. Separate several addresses with commas.
FORMS_NOTIFY_EMAIL=

# Optional: where replies to confirmation emails should go.
FORMS_REPLY_TO=

# Brevo contact list IDs (the number shown next to each list in Brevo).
BREVO_WAITLIST_LIST_ID=
BREVO_NEWSLETTER_LIST_ID=
