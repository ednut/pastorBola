{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "plum-900", "name": "Deep aubergine", "color": "#2b0a1a" },
        { "slug": "plum", "name": "Ruby", "color": "#8a1538" },
        { "slug": "plum-hover", "name": "Dark ruby", "color": "#701030" },
        { "slug": "berry", "name": "Raspberry", "color": "#a3204a" },
        { "slug": "gold", "name": "Gold", "color": "#d4a23a" },
        { "slug": "gold-soft", "name": "Soft gold", "color": "#f0cf7a" },
        { "slug": "gold-text", "name": "Gold text", "color": "#8a6414" },
        { "slug": "ivory", "name": "Ivory", "color": "#fffaf5" },
        { "slug": "parchment", "name": "Blush", "color": "#f8e9e7" },
        { "slug": "sand", "name": "Sand", "color": "#f1dcd8" },
        { "slug": "ink", "name": "Ink", "color": "#261a20" },
        { "slug": "muted", "name": "Muted text", "color": "#6b5560" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "serif", "name": "Bodoni Moda", "fontFamily": "\"Bodoni Moda\", Georgia, serif",
          "fontFace": [
            { "fontFamily": "Bodoni Moda", "fontWeight": "400", "fontStyle": "normal", "src": ["file:./assets/fonts/bodoni-moda-400.woff2"] },
            { "fontFamily": "Bodoni Moda", "fontWeight": "500", "fontStyle": "normal", "src": ["file:./assets/fonts/bodoni-moda-500.woff2"] },
            { "fontFamily": "Bodoni Moda", "fontWeight": "400", "fontStyle": "italic", "src": ["file:./assets/fonts/bodoni-moda-italic-400.woff2"] }
          ]
        },
        {
          "slug": "sans", "name": "DM Sans", "fontFamily": "\"DM Sans\", system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "DM Sans", "fontWeight": "400", "fontStyle": "normal", "src": ["file:./assets/fonts/dm-sans-400.woff2"] },
            { "fontFamily": "DM Sans", "fontWeight": "500", "fontStyle": "normal", "src": ["file:./assets/fonts/dm-sans-500.woff2"] },
            { "fontFamily": "DM Sans", "fontWeight": "600", "fontStyle": "normal", "src": ["file:./assets/fonts/dm-sans-600.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Body", "size": "1.0625rem" },
        { "slug": "lead", "name": "Lead", "size": "1.1875rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.5rem, 1.2rem + 1vw, 2rem)" },
        { "slug": "x-large", "name": "Section heading", "size": "clamp(2.6rem, 1.8rem + 3.4vw, 4.25rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(3.2rem, 2rem + 5.4vw, 6.5rem)" }
      ]
    },
    "layout": { "contentSize": "820px", "wideSize": "1280px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ivory)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.7" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "400", "lineHeight": "1.06", "letterSpacing": "-0.035em" } }
    }
  }
}
