{#- Book waiting list form. Posts to /api/forms (see lib/forms.js). Used on the book page. -#}
{%- from "partials/macros.njk" import arrow -%}
<form class="waitlist" name="waitlist" method="POST" action="/api/forms" data-form data-success="Thank you, you’re on the waiting list. A confirmation is on its way to your inbox, and we’ll be in touch as soon as the book is available.">
  <input type="hidden" name="form-name" value="waitlist">
  <p class="hp"><label>Company <input name="company" tabindex="-1" autocomplete="off"></label></p>
  <div class="form">
    <div class="field full"><label for="wl-name">Full name</label><input class="input" id="wl-name" name="name" autocomplete="name" required></div>
    <div class="field"><label for="wl-email">Email address</label><input class="input" id="wl-email" type="email" name="email" autocomplete="email" required></div>
    <div class="field"><label for="wl-phone">Phone or WhatsApp number</label><input class="input" id="wl-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+234 803 000 0000" pattern="\+[0-9][0-9 \(\)\-]{6,18}" title="Include your country code, for example +234 or +44" required><span class="hint">Include your country code, for example +234 or +44.</span></div>
    <label class="check full"><input type="checkbox" name="consent" required><span>I agree that Pastor Bola’s team may contact me about this book using these details. See our <a class="link" href="/privacy/">privacy notice</a>.</span></label>
    <div class="full"><button class="btn" type="submit">Join the waiting list {{ arrow() }}</button></div>
  </div>
  <p class="form-status mt-2" role="status" aria-live="polite"></p>
</form>
