{#- → WordPress: template-parts/site-header.php. Menu becomes wp_nav_menu( 'primary' ). -#}
{%- from "partials/macros.njk" import arrow -%}
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="{{ site.name }} — home">
      <small>Pastor</small>Bola Akinlabi
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__label">Menu</span><span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list">
        {%- for item in nav.primary %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
      <a class="btn" href="{{ nav.cta.url }}">{{ nav.cta.label }} {{ arrow() }}</a>
    </nav>
  </div>
</header>
