---
layout: layouts/base.njk
title: Books & resources
pageClass: books
permalink: /books/
description: Download Pastor Bola Akinlabi's first book, Words to Build On. Words of faith, purpose and practical wisdom for every season.
---
{%- from "partials/macros.njk" import arrow, bookCover, pageHero -%}

{{ pageHero("Books & resources", "Words to <em>build on.</em>", "Pastor Bola’s first book is ready to download. Words of faith, purpose and practical wisdom for every season.") }}

{%- for book in books %}
<section class="section" style="padding-top:0" aria-labelledby="book-{{ book.slug }}">
  <div class="wrap split">
    <div class="reveal" style="padding-block:var(--s-4)">{{ bookCover(book) }}</div>
    <div>
      <span class="tag reveal">{{ book.statusLabel }}</span>
      <h2 id="book-{{ book.slug }}" class="mt-3 reveal" data-delay="1">{{ book.coverTitle | safe }}</h2>
      <p class="muted mt-3 reveal" data-delay="2">{{ book.summary }}</p>
      <dl class="factsheet mt-4 reveal" data-delay="2">
        <dt>Title</dt><dd>{{ book.title }}</dd>
        <dt>Author</dt><dd>Bola Akinlabi</dd>
        <dt>Format</dt><dd>{{ book.format }}</dd>
      </dl>
      {%- if book.downloadUrl %}
      <div class="btn-row mt-4 reveal" data-delay="3">
        <a class="btn" href="{{ book.downloadUrl }}" download>{{ book.downloadLabel }} {{ arrow() }}</a>
        <a class="link" href="/contact/">Share it with your group {{ arrow() }}</a>
      </div>
      {%- endif %}

    </div>
  </div>
</section>
{%- endfor %}

<section class="section section--parchment" aria-labelledby="themes-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 id="themes-title" class="reveal" data-delay="1">Faith for <em>everyday life.</em></h2>
      </div>
    </div>
    <div class="cards-3">
      <div class="card reveal"><h3>Purpose &amp; calling</h3><p>Discovering what God has placed in your hands, and having the courage to build with it.</p></div>
      <div class="card reveal" data-delay="1"><h3>Leadership</h3><p>Excellence, structure and integrity, from the boardroom to the church and the home.</p></div>
      <div class="card reveal" data-delay="2"><h3>Family &amp; restoration</h3><p>Strong marriages, nurtured children, and hope for what has been lost.</p></div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="faq-title">
  <div class="wrap split" style="align-items:start">
    <div>
      <h2 id="faq-title" class="mt-2 reveal" data-delay="1">For readers, churches <em>and groups.</em></h2>
    </div>
    <div class="faq reveal" data-delay="1">
      <details><summary>How do I get the book?</summary><div><p>Use the download button at the top of this page. There is no sign-up or waiting list.</p></div></details>
      <details><summary>Can our church or women’s group share it?</summary><div><p>Yes. Send a note through the contact page and the team will help you share it with your church, small group or conference.</p></div></details>
    </div>
  </div>
</section>
